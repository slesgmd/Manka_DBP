{
  "expo": {
    "name": "Manka",
    "slug": "manka",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#C9CEDC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.CAMERA"
      ],
      "package": "com.seblescano.manka"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Manka usa la cámara para leer el código de barras de tus productos y agregarlos a tu despensa.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Manka usa el movimiento del celular para que agites y recibas un plato sorpresa."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "57bc1400-3db3-4bb7-8303-42a76182ced7"
      }
    },
    "owner": "seblescano",
    "updates": {
      "url": "https://u.expo.dev/57bc1400-3db3-4bb7-8303-42a76182ced7"
    },
    "runtimeVersion": "exposdk:58.0.0"
  }
}
